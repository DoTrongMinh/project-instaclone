<div class="row" >
<div class="col-12 text-center" style="padding: 20px; margin-left:20px;width: 85%;margin: 0 auto; text-align: center; ">
<h1><%= @user.username %></h1>
<h4><%= @user.email %></h4>
<h1><%= @user.bio %></h1>
</div>
</div>
 <% if @user.avatar.attached? %>
      <%= image_tag @user.avatar, style:"width: 50px; height: 50px;" %>
 <%end%>
 <% if current_user.following?(@user) %>
<%= button_to "Unfollow", unfollow_path(@user), method: :delete, class: "btn btn-link" %>
 <% elsif current_user.sent_follow_request_to?(@user) %>
 <%= button_to "Cancel follow request", cancel_path(@user), method: :delete %>
 <% else %>
 <%= button_to "Follow", follow_path(@user) %>
 <%end%>
